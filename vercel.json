{
    "version": 2,
    "builds": [
        {
            "src": "uzhavarhub_project/wsgi.py",
            "use": "@vercel/python",
            "config": {
                "runtime": "python3.9",
                "includeFiles": [
                    "ai_services/**/models/**",
                    "data/raw/**"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "uzhavarhub_project/wsgi.py"
        }
    ]
}
